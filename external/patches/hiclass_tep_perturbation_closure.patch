diff --git a/source/models/tep.c b/source/models/tep.c
new file mode 100644
index 0000000..c043c9a
--- /dev/null
+++ b/source/models/tep.c
@@ -0,0 +1,95 @@
+#include "common.h"
+#include "background.h"
+#include "tep.h"
+#include "parser.h"
+
+int smg_tep_init(struct file_content * pfc, struct background *pba, struct smg_tep_params *params, ErrorMsg errmsg) {
+    // Default values
+    params->alpha_eff = 1.0e6;
+    params->phi_init = 0.0;
+    params->B_phi_coeff = 0.0;
+    params->screening_threshold = 1.8e-124;
+    params->beta = 1.0;
+    
+    class_read_double("tep_alpha_eff", params->alpha_eff);
+    class_read_double("tep_phi_init", params->phi_init);
+    class_read_double("tep_B_coeff", params->B_phi_coeff);
+    class_read_double("tep_beta", params->beta);
+    
+    return _SUCCESS_;
+}
+
+double tep_alpha_M(struct background *pba, double phi, double phi_prime, double H) {
+    double M_pl = 1.0; 
+    double beta = pba->tep_params.beta;
+    return (2.0 * beta / M_pl) * (phi_prime / H);
+}
+
+double tep_alpha_T(struct background *pba, double phi, double phi_prime, double H) {
+    return 0.0;
+}
+
+double tep_alpha_B(struct background *pba, double phi, double phi_prime, double H, double H_prime) {
+    double X = 0.5 * phi_prime * phi_prime;
+    double f_B = tep_f_B_coupling(phi, X, pba->tep_params);
+    return -(H_prime * phi_prime / (H * H)) * f_B;
+}
+
+double tep_alpha_K(struct background *pba, double phi, double phi_prime, double H) {
+    double M_pl = 1.0;
+    double X = 0.5 * phi_prime * phi_prime;
+    double f_K = tep_f_K_coupling(phi, X, pba->tep_params);
+    return (phi_prime * phi_prime / (H * H * M_pl * M_pl)) * f_K;
+}
+
+double tep_f_B_coupling(double phi, double X, struct smg_tep_params params) {
+    double screening = tep_screening_factor(phi, params);
+    return params.alpha_eff * screening;
+}
+
+double tep_f_K_coupling(double phi, double X, struct smg_tep_params params) {
+    double screening = tep_screening_factor(phi, params);
+    return params.alpha_eff * screening;
+}
+
+double tep_screening_factor(double phi, struct smg_tep_params params) {
+    double rho_eff = exp(-phi);
+    double factor = 1.0 / (1.0 + exp((rho_eff - params.screening_threshold) / (0.1 * params.screening_threshold)));
+    return factor;
+}
+
+int smg_tep_gravity_functions(struct background *pba, double *pvecback, double *pvecgravity) {
+    double phi = pvecback[pba->index_bg_phi_smg];
+    double phi_prime = pvecback[pba->index_bg_phi_prime_smg];
+    double H = pvecback[pba->index_bg_H];
+    double H_prime = pvecback[pba->index_bg_H_prime];
+    
+    pvecgravity[pba->index_bg_kineticity_smg] = tep_alpha_K(pba, phi, phi_prime, H);
+    pvecgravity[pba->index_bg_braiding_smg] = tep_alpha_B(pba, phi, phi_prime, H, H_prime);
+    pvecgravity[pba->index_bg_tensor_excess_smg] = tep_alpha_T(pba, phi, phi_prime, H);
+    pvecgravity[pba->index_bg_M2_running_smg] = tep_alpha_M(pba, phi, phi_prime, H);
+    
+    return _SUCCESS_;
+}
+
+int smg_tep_background_evolution(struct background *pba, double * pvecback, double a, double *y, double *dy) {
+    double phi_prime = y[pba->index_bi_phi_prime_smg];
+    double H = pvecback[pba->index_bg_H];
+    double M_pl = 1.0;
+    
+    // Conformal time derivatives: dy = d/dln(a)
+    dy[pba->index_bi_phi_smg] = phi_prime / (a * H);
+    
+    // Trace of energy-momentum tensor T = -rho + 3p
+    double T_mu_mu = -(pvecback[pba->index_bg_rho_tot] - 3.0 * pvecback[pba->index_bg_p_tot]);
+    
+    double beta = pba->tep_params.beta;
+    double screening = tep_screening_factor(y[pba->index_bi_phi_smg], pba->tep_params);
+    double Q_TEP = (beta / M_pl) * T_mu_mu * screening;
+    
+    // phi'' + 2*H*phi' = a^2 * Q_TEP
+    // In d/dln(a) variables:
+    dy[pba->index_bi_phi_prime_smg] = (-2.0 * H * phi_prime + a * a * Q_TEP) / (a * H);
+    
+    return _SUCCESS_;
+}
