--- /dev/null
+++ b/gravity_smg/tep.c
@@ -0,0 +1,267 @@
+/**
+ * @file tep.c
+ * @brief TEP (Temporal Equivalence Principle) model for hi_class
+ *
+ * Active scalar perturbation closure via exact Bellini-Sawicki
+ * alpha functions derived from the TEP conformal factor A(z).
+ * All alphas are computed at runtime from the dimensionless
+ * Jordan-frame coupling alpha_A = d ln A / d ln a
+ * (= -d ln A / d ln(1+z); same convention as tep_alpha_A in
+ * background.c and the Python alpha_A_native).
+ *
+ * Pure conformal limit (B=0, beta_A = -1.0, phi = -ln A):
+ *   alpha_M = -2 * S_Sigma * alpha_A     (S_Sigma = tep_screening_s;
+ *                                       alpha_B = -alpha_M follows
+ *                                       from F = M^2 A^{-2S})
+ *   alpha_B =  2 * S_Sigma * alpha_A
+ *   alpha_K = wc * alpha_A^2              (wc S-independent)
+ *   alpha_T =  0
+ *
+ * Covariant completion: G4 = (M^2/2) e^{2 S phi} = M^2 A^{-2S}/2
+ * (the manuscript's F = M^2 A^{-2} map at S=1), G2_X = wc M^2 e^{2S phi},
+ * with wc = Z_E - 6 beta_A^2 the Jordan-frame kinetic coefficient and
+ * Z_E = P_X + 2 X P_XX the Einstein-frame kinetic coefficient of the
+ * scalar. The Horndeski map (as for the built-in brans_dicke model:
+ * alpha_B = -alpha_M, alpha_K = 2X G2_X/(H^2 M_*^2)) gives the stored
+ * alphas above.
+ *
+ * Stability: the no-ghost discriminant D = alpha_K + (3/2)*alpha_B^2
+ * = (wc + 6 S^2) alpha_A^2 is positive on both branches, but D > 0 is
+ * NOT sufficient for linear stability. The canonical-EF image
+ * wc = -5 (Z_E = 1, the published alpha_K = -5 alpha_A^2 map) is
+ * linearly unstable on the TEP background — a tachyonic/scalarization
+ * growing mode with median P(k) enhancement ~1e8, verified with the
+ * delta-phi closure and self-consistent U_phi (2026-10-01 audit;
+ * results/closure_response_scan.json). The minimal stable completion
+ * is wc = +7 (Z_E = 13). tep_kin_boost: K > 0 sets wc = 7 K^2, K < 0
+ * sets wc = K directly. S_Sigma < 1 suppresses the fifth force
+ * genuinely (bra^2/kin ~ S^2/wc) because wc does not scale with S;
+ * scaling alpha_K ~ S^2 (the published -5 (S alpha_A)^2 form) leaves
+ * bra^2/D invariant and does not screen.
+ *
+ * @author: TEP-HC Pipeline
+ * @version: v0.8-Cambridge
+ */
+
+#include "common.h"
+#include "background.h"
+#include "gravity_models_smg.h"
+#include "tep.h"
+
+/**
+ * @brief Initialize TEP model parameters from input file
+ */
+int smg_tep_init(struct background *pba, struct smg_tep_params *params) {
+    /*
+     * The SMG alpha-table route is deprecated. TEP perturbation closure
+     * now uses exact runtime alpha functions from the conformal factor.
+     * alpha_eff is retained for backward compatibility but is inactive.
+     */
+    params->alpha_eff = 1.0e6;
+    params->phi_init = 0.0;
+    params->B_phi_coeff = 0.0;
+    params->screening_threshold = 1.8e-124;
+    params->beta = -1.0;
+
+    return _SUCCESS_;
+}
+
+/**
+ * @brief Set exact TEP alpha functions into pvecback at given scale factor.
+ * Called from gravity_models_get_alphas_par_smg for the tep model.
+ *
+ * All alphas derive from the single dimensionless quantity alpha_A(z),
+ * computed identically to the background-only Hubble modification.
+ * This guarantees background--perturbation consistency to machine precision.
+ */
+int smg_tep_get_alphas(
+    struct background *pba,
+    double a,
+    double *pvecback,
+    double delta_M2
+) {
+    double z = 1.0 / a - 1.0;
+
+    /* 1. Fetch the exact native background derivative from background.c.
+       tep_alpha_A computes d ln A / d ln a (= -d ln A / d ln(1+z))
+       using the same math as tep_M_factor, ensuring perfect internal
+       consistency. */
+    double alpha_A = tep_alpha_A(pba, z);
+
+    /* 2. Pure Conformal Limit Mappings (beta_A = -1.0), field convention
+       phi = -ln A.  The scalar mixing is suppressed by the environmental
+       factor S_Sigma (tep_screening_s) while the kinetic coefficient wc is
+       NOT scaled by S: scaling alpha_K ~ S^2 as well would leave
+       bra^2/D invariant and defeat the screening (verified numerically).
+       Since the screened coupling is F = M^2 A^{-2S}, self-consistency
+       (alpha_B = -alpha_M) requires alpha_M = -2 S alpha_A as well:
+         alpha_M = -2 S alpha_A, alpha_B = 2 S alpha_A,
+         alpha_K = wc alpha_A^2.
+       wc = Z_E - 6 is the Jordan-frame kinetic coefficient of the
+       canonical-EF image W = A^{-2}(Z_E - 6 beta_A^2), where
+       Z_E = P_X + 2 X P_XX is the Einstein-frame kinetic coefficient of
+       scalar fluctuations on the cosmological background.  Canonical
+       (Z_E = 1): wc = -5 -> linearly unstable (scalarization channel).
+       Screened branch (tep_kin_boost K > 0): wc = 7 K^2. */
+    double Sscr = pba->tep_screening_s;
+    if (Sscr <= 0.0) Sscr = 1.0;
+    double Kb = pba->tep_kin_boost;
+    if (Kb == 0.0) Kb = 1.0;
+    double wc = (Kb < 0.0) ? Kb : 7.0*Kb*Kb;
+    double alpha_M = -2.0 * Sscr * alpha_A;
+    double alpha_B =  2.0 * Sscr * alpha_A;
+    double alpha_K = wc * (alpha_A * alpha_A);
+    double alpha_T =  0.0;
+
+    pvecback[pba->index_bg_kineticity_smg] = alpha_K;
+    pvecback[pba->index_bg_braiding_smg] = alpha_B;
+    pvecback[pba->index_bg_tensor_excess_smg] = alpha_T;
+    pvecback[pba->index_bg_M2_running_smg] = alpha_M;
+
+    if (pba->M2_evolution_smg == _TRUE_) {
+      pvecback[pba->index_bg_delta_M2_smg] = delta_M2;
+      pvecback[pba->index_bg_M2_smg] = 1.0 + delta_M2;
+    }
+    else {
+      pvecback[pba->index_bg_delta_M2_smg] = 0.0;
+      pvecback[pba->index_bg_M2_smg] = 1.0;
+    }
+
+    /* ------------------------------------------------------------------
+       Scalar-sector columns for the deltaphi perturbation closure
+       (use_pert_var_deltaphi_smg = yes).
+
+       The TEP scalar is prescribed rather than integrated: the covariant
+       action consistent with the stored alphas is the Jordan-frame
+       Horndeski form
+         S = Int sqrt(-g) [ G4(phi) R + W(phi) X - U(phi) ],
+         G4 = (M^2/2) e^{2 S phi} = M^2 A^{-2S}/2,
+         W  = wc M^2 e^{2 S phi},
+       with field convention phi = -ln A (beta_A = -1), for which
+       bra_s = -2 G4_phi/M^2 = -2 S and kin_ss = G2_X/M^2 = wc
+       identically, giving the kinetic discriminant
+         D_over_phiphi = kin_ss + 3 bra_s^2/2 = wc + 6 S^2.
+       wc = Z_E - 6 is the Jordan-frame kinetic coefficient: wc = -5
+       (Z_E = 1, the canonical-EF image) is linearly unstable on this
+       background; production uses wc = +700 (tep_kin_boost = 10,
+       Z_E = 706).  delta_phi is the regular variable: the alternative
+       x_smg = delta_phi/phi' divides by phi' ~ alpha_A, which crosses
+       zero during the transition and injects a spurious coordinate
+       mass into the perturbation equation.
+
+       Field trajectory: phi = -ln A(z), hence d phi/d ln a = -alpha_A
+       (alpha_A is defined w.r.t. ln a).
+       index_bg_H is the physical (non-conformal) Hubble rate, so the
+       conformal-time field derivative is phi' = -alpha_A * a * H and
+         phi'' = -(a H)^2 [ alpha_A,N + alpha_A (1 + eta) ],
+         eta = d ln H/d ln a = H'/(a H^2).
+
+       The potential slope is reconstructed on-shell from the scalar
+       equation R0 phi'' + R1 H' + R2 = 0 of the same action, which
+       reduces to
+         U_phi = M^2 ( 6 S T2 - wc T1 - 2 S wc X ),
+         X = alpha_A^2 H^2/2,  T1 = (phi'' + 2 a H phi')/a^2,
+         T2 = H'/a + 2 H^2.
+       In radiation domination H' = -2 a H^2, so T2 vanishes and
+       U_phi ~ 0 at early times.  Its phi-derivative U_phiphi (needed
+       by B9) is a free designer input; the flat-potential choice
+       U_phiphi = 0 is used. */
+    {
+      double z_eval = (z > 0.0) ? z : 0.0;
+      double H  = pvecback[pba->index_bg_H];
+      double Hp = pvecback[pba->index_bg_H_prime];
+      double aH = a*H;
+      double eta = (H != 0.0) ? Hp/(aH*H) : 0.0;
+
+      /* d alpha_A / d ln a = -(1+z) d alpha_A/dz, finite-differenced
+         in the same style as d ln M/d ln a in get_back_par. */
+      double dza = 1e-6*(1.0 + z_eval);
+      if (dza < 1e-9) dza = 1e-9;
+      double dalphaA_dz = (tep_alpha_A(pba, z_eval + dza)
+                         - ((z_eval - dza > 0.0)
+                            ? tep_alpha_A(pba, z_eval - dza)
+                            : tep_alpha_A(pba, 0.0)))/(2.*dza);
+      double alpha_A_N = -(1.0 + z_eval)*dalphaA_dz;
+
+      /* Field trajectory is FIXED by the clock profile: phi = -ln A(z),
+         phi' = -alpha_A a H, independent of the screening strength. */
+      double phi_prime = -alpha_A*aH;
+      double phi_pp   = -aH*aH*(alpha_A_N + alpha_A*(1.0 + eta));
+
+      double Xv0 = 0.5*alpha_A*alpha_A*H*H;
+      double T10 = -H*H*(alpha_A_N + alpha_A*(3.0 + eta));
+      double T2 = Hp/a + 2.0*H*H;
+      double M2 = pvecback[pba->index_bg_M2_smg];
+
+      pvecback[pba->index_bg_phi_smg] = -log(tep_gamma_factor(pba, z_eval));
+      pvecback[pba->index_bg_phi_prime_smg] = phi_prime;
+      pvecback[pba->index_bg_phi_prime_prime_smg] = phi_pp;
+      /* R-eq: U_phi = M^2 (6 S T2 - wc T1 - 2 S wc X)
+         for G4_phi = S M^2 e^{2 S phi}, G2_X = wc M^2 e^{2 S phi}
+         with field convention phi = -ln A (beta_A = -1). */
+      pvecback[pba->index_bg_U_phi_smg] = M2*(6.0*Sscr*T2 - wc*T10 - 2.0*Sscr*wc*Xv0);
+
+      /* Exact, alpha_A-safe values for the over_phi EFT coefficients.
+         bra_s = -2 G4_phi/M^2 = -2 S; kin_ss = G2_X/M^2 = wc.
+         Checks: bra = bra_s phi'/aH = 2 S alpha_A; kin = wc alpha_A^2;
+         D_over_phiphi = kin_ss + 1.5 bra_s^2 = wc + 6 S^2.  The fifth
+         force scales as bra^2/kin ~ 4 S^2 alpha_A^2 / wc, so S_Sigma
+         genuinely suppresses it only because wc is S-independent. */
+      pvecback[pba->index_bg_kineticity_over_phiphi_smg] = wc;
+      pvecback[pba->index_bg_braiding_over_phi_smg] = -2.0*Sscr;
+      pvecback[pba->index_bg_beyond_horndeski_over_phi_smg] = 0.0;
+    }
+
+    return _SUCCESS_;
+}
+
+
+/**
+ * @brief Fill the G_functions_and_derivs structure for the TEP action.
+ *
+ * Covariant functions consistent with the stored TEP alphas:
+ *   G4 = (M^2/2) e^{2 S phi} = M^2 A^{-2S}/2,  W = wc M^2 e^{2 S phi}
+ *   (screened conformal completion, phi = -ln A; the canonical-EF image
+ *   wc = -5 is tachyonic; production wc = 7 K^2 with K = tep_kin_boost),
+ *   G2 = W X - U, U_phi reconstructed along the trajectory.
+ * Called from background_solve_smg when building the B_i coefficients
+ * for the deltaphi perturbation closure.
+ */
+int smg_tep_get_Gs(
+    struct background *pba,
+    double *pvecback,
+    double U_phiphi,
+    struct G_functions_and_derivs *pgf
+) {
+    double a   = pvecback[pba->index_bg_a];
+    double M2  = pvecback[pba->index_bg_M2_smg];
+    double phi_prime = pvecback[pba->index_bg_phi_prime_smg];
+    double U_phi = pvecback[pba->index_bg_U_phi_smg];
+    double X = 0.5*pow(phi_prime/a, 2);
+
+    /* Screened conformal completion, phi = -ln A: G4 = (M^2/2) e^{2 S phi}
+       gives G4_phi = S M^2 along the trajectory; G2_X = wc M^2 e^{2 S phi}
+       with wc the S-independent Jordan kinetic coefficient, so
+       kin_ss = wc and bra_s = -2 S (S_Sigma suppresses the fifth force
+       only because wc does not scale with S). */
+    double Sscr = pba->tep_screening_s;
+    if (Sscr <= 0.0) Sscr = 1.0;
+    double Kb = pba->tep_kin_boost;
+    if (Kb == 0.0) Kb = 1.0;
+    double S2 = Sscr*Sscr, S3 = S2*Sscr, K2 = Kb*Kb;
+    double wc = (Kb < 0.0) ? Kb : 7.0*K2;
+
+    pgf->G4 = 0.5*M2;
+    pgf->DG4 = 0.5*pvecback[pba->index_bg_delta_M2_smg];
+    pgf->G4_phi = Sscr*M2;
+    pgf->G4_phiphi = 2.0*S2*M2;
+    pgf->G4_phiphiphi = 4.0*S3*M2;
+
+    pgf->G2_X = wc*M2;
+    pgf->G2_Xphi = 2.0*Sscr*wc*M2;
+    pgf->G2_Xphiphi = 4.0*S2*wc*M2;
+    pgf->G2_phi = 2.0*Sscr*wc*M2*X - U_phi;
+    pgf->G2_phiphi = 4.0*S2*wc*M2*X - U_phiphi;
+
+    return _SUCCESS_;
+}
