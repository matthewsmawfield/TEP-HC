+
+#include "common.h"
+
+/* File-scope forward declaration so that prototypes below use the same
+ * tag as the definition in gravity_models_smg.h regardless of include
+ * order (tep.h is pulled in via background.h). */
+struct G_functions_and_derivs;
+
+/**
+ * @brief TEP model parameters structure
+ */
